{
  "name": "cricket-cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate:users:dry": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-users.ts --dry-run",
    "migrate:users": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-users.ts",
    "seed:regions": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-regions.ts",
    "seed:sports": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-sports.ts",
    "seed:series": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-series.ts",
    "seed:teams": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-teams.ts",
    "seed:players": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-players.ts",
    "seed:tags": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-tags.ts",
    "seed:categories": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-categories.ts",
    "migrate:articles": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-articles.ts",
    "migrate:articles:dry": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-articles.ts --dry-run",
    "seed:advertisements": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-advertisements.ts",
    "seed:navbars": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-navbars.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "payload": "3.93.0",
    "pg": "^8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
